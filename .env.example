DATABASE_URL="postgresql://ee_owner:CHANGEME@localhost:5432/ee_rent_tracker"
SHADOW_DATABASE_URL="postgresql://ee_owner:CHANGEME@localhost:5432/ee_rent_tracker_shadow"
# The running application connects as the NON-OWNER role so RLS applies.
APP_DATABASE_URL="postgresql://ee_app:CHANGEME@localhost:5432/ee_rent_tracker"

# Pepper for login-code hashing. 6-digit codes are only ~20 bits of entropy,
# so an HMAC secret is what stops offline brute force if the DB ever leaks.
AUTH_SECRET="CHANGEME-generate-with-openssl-rand-base64-32"

# --- Email delivery -------------------------------------------------------
# Without RESEND_API_KEY the console mailer is used (development only; it
# refuses to run under NODE_ENV=production so login codes cannot be silently
# dropped).
# RESEND_API_KEY="re_..."
# MAIL_FROM="EE Rent Tracker <login@yourdomain.com>"

# --- HTTP -----------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"
# Set to 1 ONLY behind a proxy you control. Trusting X-Forwarded-For otherwise
# lets anyone defeat per-IP rate limits by inventing a header.
# TRUST_PROXY=1

# Where background-job failures are reported. Unset means nobody is told.
ALERT_EMAIL="you@example.com"

# --- Stripe ---------------------------------------------------------------
# Test keys from dashboard.stripe.com. Connect must be enabled on the account.
STRIPE_SECRET_KEY="sk_test_CHANGEME"
# From the webhook endpoint you register; signs the raw request body.
STRIPE_WEBHOOK_SECRET="whsec_CHANGEME"
