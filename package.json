{
  "name": "ee-rent-tracker",
  "version": "1.0.0",
  "description": "Rent, utility, and payment tracking for small landlords.",
  "scripts": {
    "db:roles": "psql \"$DATABASE_URL\" -v owner_role=\"${OWNER_ROLE:-ee_owner}\" -v app_password=\"$EE_APP_PASSWORD\" -v ON_ERROR_STOP=1 -f db/sql/0000_roles.sql",
    "db:migrate": "prisma migrate deploy",
    "db:verify": "set -a && . ${ENV_FILE:-./.env} && set +a && psql \"$DATABASE_URL\" -f db/test/verify_objects.sql",
    "db:seed": "set -a && . ${ENV_FILE:-./.env} && set +a && psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/test/0001_seed.sql",
    "db:test": "set -a && . ${ENV_FILE:-./.env} && set +a && psql \"$DATABASE_URL\" -f db/test/0002_constraints.sql && psql \"$APP_DATABASE_URL\" -f db/test/0003_rls.sql",
    "db:check": "node --env-file=${ENV_FILE:-.env} node_modules/.bin/tsx src/db.check.ts",
    "auth:check": "node --env-file=${ENV_FILE:-.env} node_modules/.bin/tsx src/auth.check.ts",
    "typecheck": "tsc --noEmit",
    "http:check": "node --env-file=${ENV_FILE:-.env} node_modules/.bin/tsx src/http.check.ts",
    "dev": "node --env-file=${ENV_FILE:-.env} node_modules/.bin/tsx watch src/http/server.ts",
    "billing:check": "node --env-file=${ENV_FILE:-.env} node_modules/.bin/tsx src/billing.check.ts",
    "billing:run": "node --env-file=${ENV_FILE:-.env} node_modules/.bin/tsx src/billing/run.ts",
    "stripe:check": "node --env-file=${ENV_FILE:-.env} node_modules/.bin/tsx src/stripe.check.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SPeterson97/EE-Rent-Tracker.git"
  },
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/SPeterson97/EE-Rent-Tracker/issues"
  },
  "homepage": "https://github.com/SPeterson97/EE-Rent-Tracker#readme",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "private": true,
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "pg": "^8.23.0",
    "stripe": "^22.5.0"
  }
}
